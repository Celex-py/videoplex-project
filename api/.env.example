# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/videoplatform"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# ── Mux ───────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.mux.com → Settings → API Access Tokens
MUX_ACCESS_TOKEN="your-mux-access-token"
MUX_SECRET_KEY="your-mux-secret-key"
# Get this from https://dashboard.mux.com → Settings → Webhooks
MUX_WEBHOOK_SECRET="your-mux-webhook-signing-secret"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"
